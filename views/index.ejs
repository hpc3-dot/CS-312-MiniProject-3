<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/style.css" type="text/css">
    <title>Blog Project</title>
</head>
<body>
    <div class="container">
        <header class="header">
            <div class="hero">
            </div>
        </header>
        <div class="about-api-container">
            <div class="about">
                <div class="about-blog">
                    <h2>About This Blog</h2>
                    <p>This blog was created for everyone to share their experience fly-fishing. It was inspired by my love of fishing, and hearing about other peoples' eyes light up when they are telling the story of the "Big One" they hooked!</p>
                </div>
                <div class="logged-in">
                    <h2>Welcome, <%= locals.username %></h2>
                    <form action="/logout" method="GET">
                        <button type="submit">Logout</button>
                    </form>
                     <form action="/account" method="GET">
                        <button type="submit">Edit Account</button>
                    </form>

                </div>
            </div>
            <div class="forecast">
                <h1>Check the weather before your next trip!</h1>
                <div class="weather-top">
                    <div class="weather-search">
                        <h3>Enter a Zip Code to Check Weather</h3>
                    <form action="/weather" method="POST">
                        <input type="text" id="zipCode" name="zipCode" placeholder="Enter Zip Code" required>
                        <button type="submit">Search</button>
                    </form>
                    </div>
                <% if (locals.weather) { %>
                    <div class="current-forecast">
                        <% if (locals.location) { %>
                            <h2>Current Weather for <%= location.name %>:</h2>
                        <% } %>
                        <p>Temp: <%= weather.current.temp %> &deg;F </p>
                        <p>Feels Like: <%= weather.current.feels_like %>&deg;F</p>
                        <p>Humidity: <%= weather.current.humidity %>%</p>
                        <p>Wind Speed: <%=weather.current.wind_speed %> mph</p>
                    </div>
                </div>
                <h2>Seven day Forecast for <%= location.name %>:</h2>
                    <div class="weather-card-container">
                        <% for(let i=1; i<weather.daily.length; i++ ){ %>
                            <div class="weather-card">
                                <h3> <%= new Date(weather.daily[i].dt *1000).toLocaleDateString("en-us",{ weekday: "long"})%></h3>
                                <p>High: <%= weather.daily[i].temp.max %> &deg;F </p>
                                <p>Low: <%= weather.daily[i].temp.min %>&deg;F</p>
                                <p>Humidity: <%= weather.daily[i].humidity %>%</p>
                                <p>Wind Speed: <%= weather.daily[i].wind_speed %> mph</p>
                            </div>
                        <% } %>
                    </div>
                        
                <% } else { %>
                <p>Use the search bar to find weather</p>
            <% } %>
            </div>
        </div>    
        <main class="main">
            <div class="new-blog-post">
                <h2>Create New Blog Post</h2>
                <form action="/submit" method="POST">  
                    <input type="text" id="title" name="title" placeholder="Enter blog post title" required>
                    <textarea id="body" name="body" placeholder="Enter blog post content" required></textarea>
                    <select id="fish_type" name="fish_type">
                        <option value="">Select a fish type</option>
                        <option value="rtrout">Rainbow Trout</option>
                        <option value="btrout">Brown Trout</option>
                        <option value="brtrout">Brook Trout</option>
                        <option value="other">Other</option>
                    </select>
                    <button type="submit">Create Post</button>
                </form>

            <div class="filter">
                <h3>Filter posts by the fish!</h3>
                <form action="/home" method="GET">
                    
                    <select id="fishType" name="fishType">
                        <option value="all">All</option>
                        <option value="userPosts">My Posts</option>
                        <option value="rtrout">Rainbow Trout</option>
                        <option value="btrout">Brown Trout</option>
                        <option value="brtrout">Brook Trout</option>
                        <option value="other">Other</option>
                    </select>
                    </label>
                    <button type="submit">Filter</button>
                </form>
            </div>
            </div>
            <div class="blog-posts">
                <% if (locals.blogposts && locals.blogposts.length > 0) { %>
                   <% if (edit && editPostId) { %>
                            <% locals.blogposts.filter(post => String(post.blog_id) === String(editPostId)).forEach(function(blogpost) { %>
                                <% switch (blogpost.fish_type) { 
                                case 'rtrout': %>
                                    <div class="blog-card" style="background-image: url('/public/images/rainbow.png');">
                                <% break; 
                                
                                case 'btrout': %>
                                    <div class="blog-card" style="background-image: url('/public/images/brown.png');">
                                <% break; 
                                case 'brtrout': %>
                                    <div class="blog-card" style="background-image: url('/public/images/brook.png');">
                                <% break; 
                                case 'other': %>
                                    <div class="blog-card" style="background-image: url('/public/images/creek_bed.png');">
                                <% break; default: %>
                                    <div class="blog-card" style="background-image: url('/public/images/creek_bed.png');">
                                <% } %>
                                <form action="/updatePost" method="POST">
                                        <input type="text" id="editPostTitle" name="postTitle" value="<%= blogpost.title %>" required>
                                        <textarea id="editPostContent" name="postContent" required><%= blogpost.body %></textarea>
                                        <select id="fish_type" name="fish_type">
                                            <option value="">Select a fish type</option>
                                            <option value="rtrout">Rainbow Trout</option>
                                            <option value="btrout">Brown Trout</option>
                                            <option value="brtrout">Brook Trout</option>
                                            <option value="other">Other</option>
                                        </select>
                                        <input type="hidden" name="id" value="<%= blogpost.blog_id %>"> 
                                        <button type="submit">Save Changes</button>  
                                    </form>
                                    <form action="/cancel" method="POST">
                                        <input type="hidden" name="id" value="<%= blogpost.blog_id %>">
                                        <button type="submit">Cancel Changes</button>
                                    </form>
                                </div>
                            <% }); %>
                        <% } else { %>
                         <% locals.blogposts.forEach(function(blogpost) { %>
                            <% switch (blogpost.fish_type) { 
                                case 'rtrout': %>
                                    <div class="blog-card" style="background-image: url('/public/images/rainbow.png');">
                                <% break; 
                                
                                case 'btrout': %>
                                    <div class="blog-card" style="background-image: url('/public/images/brown.png');">
                                <% break; 
                                case 'brtrout': %>
                                    <div class="blog-card" style="background-image: url('/public/images/brook.png');">
                                <% break; 
                                case 'other': %>
                                    <div class="blog-card" style="background-image: url('/public/images/creek_bed.png');">
                                <% break; default: %>
                                    <div class="blog-card" style="background-image: url('/public/images/creek_bed.png');">
                                <% } %>
                                    <h3><%= blogpost.title %></h3>
                                    <p><%= blogpost.body %></p>
                                    <p><em>By <%= blogpost.creator_name %> on <%= blogpost.date_created %></em></p> 
                                    <div class="blog-buttons">
                                        <form action="/edit" method="POST">
                                        <input type="hidden" name="id" value="<%= blogpost.blog_id %>">
                                        <input type="hidden" name="creator_user_id" value="<%= blogpost.creator_user_id %>">
                                        <button type="submit">Edit</button>
                                        </form>
                                        <form action="/delete" method="POST">
                                        <input type="hidden" name="id" value="<%= blogpost.blog_id %>">
                                        <input type="hidden" name="creator_user_id" value="<%= blogpost.creator_user_id %>">
                                        <button type="submit">Delete</button>
                                        </form>
                                        
                                    </div>
                                </div>
                                 <% }); %>
                            <% } %>    
                <% } else { %>
                    <p>No blog posts yet.</p>
                <% } %>
             </div>
        </main>
        <footer class="footer">
            <p>&copy; 2026 Fly-fishing Experiences. All rights reserved.</p>
        
        </footer>
    </div>

    <script src="index.js"></script>
</body>
</html>








                        